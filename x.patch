+@dataclass
+class Snapshot:
+    names: tuple
+    signature: tuple
+    rows: tuple
+    parameters: np.ndarray
+    labels: tuple
+    source_variable_count: int = 0
+    equality_eliminated: int = 0
+    bound_eliminated: int = 0
+    target_bound_eliminated: int = 0
+    resolved_targets: tuple = ()
