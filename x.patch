+    max_variables: int = 32
+    max_rows: int = 400
+    max_pairs: int = 2500
+    max_fraction_bits: int = 1024
+    max_plans: int = 64
+    max_program_coefficients: int = 50000
+    max_total_coefficients: int = 250000
